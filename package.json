{
	"name": "persona-wordpress-plugin",
	"version": "1.2.0",
	"private": true,
	"description": "Local development environment for the Persona Assistant WordPress plugin.",
	"scripts": {
		"dist": "bash tools/build-dist.sh",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:clean": "wp-env clean all",
		"env:destroy": "wp-env destroy",
		"playground": "npx --yes @wp-playground/cli@latest server --blueprint=./playground/local.json --blueprint-may-read-adjacent-files --mount=.:/wordpress/wp-content/plugins/persona-assistant",
		"postinstall": "node tools/patch-wp-env.js"
	},
	"devDependencies": {
		"@wordpress/env": "^11.17.0"
	},
	"overrides": {
		"adm-zip": "^0.6.1",
		"fast-uri": "^3.1.7",
		"js-yaml": "^3.15.2",
		"proxy-addr": "^2.0.8",
		"brace-expansion": "^2.1.7",
		"http-cache-semantics": "^4.3.0",
		"simple-git": "^4.0.2",
		"@simple-git/argv-parser": "^2.0.1",
		"qs": "^6.16.0"
	}
}
